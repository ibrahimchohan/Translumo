<Window
    x:Class="Translumo.MVVM.Views.WindowPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="{DynamicResource Str.Picker.Title}"
    Width="560"
    Height="560"
    AllowsTransparency="True"
    Background="Transparent"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SourceInitialized="Window_SourceInitialized"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Border
        Margin="8"
        Padding="18"
        Background="{StaticResource Bar.Background}"
        BorderBrush="{StaticResource Bar.Border}"
        BorderThickness="1"
        CornerRadius="14"
        MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Opacity="0.5"
                ShadowDepth="2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Bar.Foreground}"
                    Text="{DynamicResource Str.Picker.Title}" />
                <Button
                    HorizontalAlignment="Right"
                    Click="Cancel_Click"
                    Style="{StaticResource BarIconButton}"
                    ToolTip="{DynamicResource Str.Picker.Cancel}">
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Kind="Close" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox
                        x:Name="SearchBox"
                        Padding="22,0,0,0"
                        Style="{StaticResource BarTextBox}"
                        TextChanged="SearchBox_TextChanged" />
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Bar.Muted}"
                        IsHitTestVisible="False"
                        Kind="Magnify" />
                </Grid>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Click="PickOnScreen_Click"
                    Style="{StaticResource BarTextButton}"
                    ToolTip="{DynamicResource Str.Picker.PickHint}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,6,0"
                            Kind="CursorDefaultClick" />
                        <TextBlock Text="{DynamicResource Str.Picker.PickOnScreen}" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    Margin="4,0,0,0"
                    Click="Refresh_Click"
                    Style="{StaticResource BarIconButton}"
                    ToolTip="{DynamicResource Str.Picker.Refresh}">
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Kind="Refresh" />
                </Button>
            </Grid>

            <ListBox
                x:Name="WindowsList"
                Grid.Row="2"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource BarListBoxItem}"
                MouseDoubleClick="WindowsList_MouseDoubleClick"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionChanged="WindowsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource Bar.Muted}"
                                Kind="ApplicationOutline" />
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{StaticResource Bar.Foreground}"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource Bar.Muted}"
                                    Text="{Binding ProcessName}" />
                            </StackPanel>
                            <Border
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{StaticResource Bar.Hover}"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBrowser}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource Bar.Foreground}"
                                    Text="{DynamicResource Str.Picker.Browser}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel
                Grid.Row="3"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Click="Cancel_Click"
                    Content="{DynamicResource Str.Picker.Cancel}"
                    Style="{StaticResource BarTextButton}" />
                <Button
                    x:Name="SelectButton"
                    Margin="8,0,0,0"
                    Click="Select_Click"
                    Content="{DynamicResource Str.Picker.Select}"
                    IsEnabled="False"
                    Style="{StaticResource BarAccentButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
